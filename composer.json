{
  "name": "advancedideamechanics/mezzio-recaptcha-v3-middleware",
  "description": "Google reCAPTCHA v3 PSR-15 Middleware and Service for Mezzio and Laminas applications",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthew Pallotta",
      "email": "matt@advanced.im",
      "homepage": "https://advanced.im"
    }
  ],
  "support": {
    "issues": "https://github.com/AdvancedIdeasMechanics/mezzio-recaptcha-v3-middleware/issues",
    "email": "support@advanced.im",
    "source": "https://github.com/AdvancedIdeasMechanics/mezzio-recaptcha-v3-middleware",
    "docs": "https://support.advanced.im"
  },
  "homepage": "https://advanced.im/product/mezzio-recaptcha-v3-middleware",
  "require": {
    "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.0 || ^2.0",
    "psr/http-server-middleware": "^1.0",
    "psr/container": "^1.0 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "AdvancedIdeasMechanics\\MezzioReCaptchaV3\\": "src/"
    }
  },
  "extra": {
    "laminas": {
      "config-provider": "AdvancedIdeasMechanics\\MezzioReCaptchaV3\\ConfigProvider"
    }
  }
}